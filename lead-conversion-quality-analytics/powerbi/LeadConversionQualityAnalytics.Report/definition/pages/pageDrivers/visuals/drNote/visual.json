                  {
                    "value": "Association, not causation",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontWeight": "bold",
                      "color": "#E85D45"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Segments are descriptive and may reflect selection, channel mix, or unobserved differences. Use these findings to prioritize controlled tests—not to claim a causal driver or automatically reroute traffic.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "fontWeight": "normal",
                      "color": "#7A6568"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
