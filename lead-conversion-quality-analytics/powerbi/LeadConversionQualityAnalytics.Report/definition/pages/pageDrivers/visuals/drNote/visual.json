                  {
                    "value": "Reliability rule",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "bold",
                      "color": "#7A1720"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Only segments meeting the project’s reliable-volume threshold are shown here. Confidence intervals and within-dimension FDR q-values remain visible.",
