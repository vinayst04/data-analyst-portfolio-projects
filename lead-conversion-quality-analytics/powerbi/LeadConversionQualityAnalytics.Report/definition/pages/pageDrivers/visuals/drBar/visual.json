              "queryRef": "ReliableSegments.Segment",
              "nativeQueryRef": "Segment",
              "active": true
            }
          ]
        },
        "Tooltips": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "ReliableSegments"
                    }
                  },
                  "Property": "Segment Leads"
                }
              },
              "queryRef": "ReliableSegments.Segment Leads",
              "nativeQueryRef": "Segment Leads"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "ReliableSegments"
                    }
                  },
                  "Property": "Segment Closed"
                }
              },
              "queryRef": "ReliableSegments.Segment Closed",
              "nativeQueryRef": "Segment Closed"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "ReliableSegments"
                    }
                  },
                  "Property": "Segment Wilson Low"
                }
              },
              "queryRef": "ReliableSegments.Segment Wilson Low",
              "nativeQueryRef": "Segment Wilson Low"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "ReliableSegments"
                    }
                  },
                  "Property": "Segment Wilson High"
                }
              },
              "queryRef": "ReliableSegments.Segment Wilson High",
              "nativeQueryRef": "Segment Wilson High"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "ReliableSegments"
                    }
                  },
                  "Property": "Segment Lift"
                }
              },
              "queryRef": "ReliableSegments.Segment Lift",
              "nativeQueryRef": "Segment Lift"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "ReliableSegments"
                    }
                  },
                  "Property": "Segment Close Rate"
                }
              },
              "queryRef": "ReliableSegments.Segment Close Rate",
              "nativeQueryRef": "Segment Close Rate"
            }
          ]
        }
      }
    },
    "objects": {
      "categoryAxis": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "showAxisTitle": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ],
      "valueAxis": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "showAxisTitle": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ],
      "labels": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
