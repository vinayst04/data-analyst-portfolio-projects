/// Precomputed segment statistics filtered to the reliable-volume threshold.
table ReliableSegments
	lineageTag: 9e9a087f-df1c-4f0a-a29d-20fc937058de

	measure 'Segment Leads' = MAX(ReliableSegments[Leads])
		formatString: #,0
		displayFolder: Segment
		lineageTag: e233a8e0-cfdb-414f-956e-078d9557be97

	measure 'Segment Closed' = MAX(ReliableSegments[Closed])
		formatString: #,0
		displayFolder: Segment
		lineageTag: 9ee240a5-a1dd-4eb6-a5cb-daf2ab1ae859

	measure 'Segment Close Rate' = MAX(ReliableSegments[CloseRate])
		formatString: 0.00%
		displayFolder: Segment
		lineageTag: 34442fb9-9557-4d0b-b2c1-3f09d03d843b

	measure 'Segment Wilson Low' = MAX(ReliableSegments[WilsonLow])
		formatString: 0.00%
		displayFolder: Segment
		lineageTag: 949b12a7-4bbd-4a57-95e1-cbe87372df09

	measure 'Segment Wilson High' = MAX(ReliableSegments[WilsonHigh])
		formatString: 0.00%
		displayFolder: Segment
		lineageTag: 97ff77f5-619f-4bb4-ab9d-402eddd677cd

	measure 'Segment Lift' = MAX(ReliableSegments[LiftVsOverall])
		formatString: 0.00x
		displayFolder: Segment
		lineageTag: 87768c80-6233-4bb3-9e4f-1011df14a977

	measure 'Segment Q Value' = MAX(ReliableSegments[QValueWithinDimension])
		formatString: 0.0000
		displayFolder: Segment
		lineageTag: 923355f3-3d61-4370-8824-fc44a1b2d8ca

