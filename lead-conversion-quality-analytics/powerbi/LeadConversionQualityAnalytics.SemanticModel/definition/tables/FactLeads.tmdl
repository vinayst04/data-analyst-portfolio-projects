	partition FactLeads = m
		mode: import
		source = let Source = Csv.Document(File.Contents("C:\path\to\lead-conversion-quality-analytics\data\sanitized\clean_leads.csv"),[Delimiter=",", Columns=32, Encoding=65001, QuoteStyle=QuoteStyle.Csv]), Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]), Typed = Table.TransformColumnTypes(Promoted,{{"LeadKey", type text},{"LeadCreated", type datetime},{"LeadDate", type date},{"WeekStart", type date},{"MonthStart", type date},{"DaysSinceStart", Int64.Type},{"CallStatus", type text},{"OutcomeBucket", type text},{"IsClosed", Int64.Type},{"IsGoodProgression", Int64.Type},{"IsBadQuality", Int64.Type},{"IsUnknown", Int64.Type},{"IsPositiveSignal", Int64.Type},{"WidgetNameNormalized", type text},{"WidgetFormPages", type text},{"WidgetDesign", type text},{"PublisherZoneName", type text},{"PublisherCampaignName", type text},{"AddressScore", type number},{"AddressScoreBand", type text},{"AddressScoreMissing", Int64.Type},{"PhoneScore", type number},{"PhoneScoreBand", type text},{"PhoneScoreMissing", Int64.Type},{"AdvertiserCampaignName", type text},{"State", type text},{"DebtLevel", type text},{"Partner", type text},{"ReferralDomain", type text},{"MarketingCampaign", type text},{"AdGroup", type text},{"Keyword", type text}}), Selected = Table.RemoveColumns(Typed,{"ReferralDomain"}) in Selected