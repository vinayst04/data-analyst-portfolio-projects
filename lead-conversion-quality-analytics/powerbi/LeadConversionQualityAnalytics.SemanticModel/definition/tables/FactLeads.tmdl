/// Sanitized lead-level fact table. No direct personal identifiers are present.
table FactLeads
	lineageTag: d73e9f9f-4411-4d13-8f2b-7eb747ff98e2

	/// Sanitized lead rows; Unknown outcomes remain in the denominator.
	measure 'Total Leads' = COUNTROWS(FactLeads)
		formatString: #,0
		displayFolder: Core KPIs
		lineageTag: 48743818-f5e6-429c-9821-2845cc409303

	measure 'Closed Leads' = SUM(FactLeads[IsClosed])
		formatString: #,0
		displayFolder: Core KPIs
		lineageTag: 1d84165d-408d-4933-8038-6ee4df91c849

	measure 'Close Rate' = DIVIDE([Closed Leads], [Total Leads])
		formatString: 0.00%
		displayFolder: Core KPIs
		lineageTag: 7cc62a4a-eec5-4a4a-b2b4-63108494f2be

	measure 'Good Progression Leads' = SUM(FactLeads[IsGoodProgression])
		formatString: #,0
		displayFolder: Quality
		lineageTag: 4f86658b-c2e1-4cc0-9edb-fc2a1d5f0351

	measure 'Good Progression Rate' = DIVIDE([Good Progression Leads], [Total Leads])
		formatString: 0.00%
		displayFolder: Quality
		lineageTag: a68aec4a-2c51-4baa-ac6f-90c60ea881e4

	measure 'Bad Quality Leads' = SUM(FactLeads[IsBadQuality])
		formatString: #,0
		displayFolder: Quality
		lineageTag: d052dbfa-01dc-4ddb-8b93-868462bd3793

	measure 'Bad Quality Rate' = DIVIDE([Bad Quality Leads], [Total Leads])
		formatString: 0.00%
		displayFolder: Quality
		lineageTag: 7e883474-6d43-467a-a5aa-75853605d8e0

	measure 'Unknown Leads' = SUM(FactLeads[IsUnknown])
		formatString: #,0
		displayFolder: Quality
		lineageTag: df34701c-a5cb-4b7c-a6f8-fded82aff037

	measure 'Unknown Rate' = DIVIDE([Unknown Leads], [Total Leads])
		formatString: 0.00%
		displayFolder: Quality
		lineageTag: 3249645f-6a0e-4014-bab4-3558a39a6156

	measure 'Target Close Rate' = 0.096
		formatString: 0.0%
		displayFolder: Target
		lineageTag: 10d6ae77-c6fd-4a95-8961-e84145235f88

	measure 'Target Closes' = CEILING([Total Leads] * [Target Close Rate], 1)
		formatString: #,0
		displayFolder: Target
		lineageTag: f12b0f63-b714-47dc-9807-edd20dc0f735

	measure 'Incremental Closes Required' = MAX(0, [Target Closes] - [Closed Leads])
		formatString: #,0
		displayFolder: Target
		lineageTag: 8f782086-0416-4bc5-97fa-8506a53bf770

	measure 'Target Gap (pp)' = ([Target Close Rate] - [Close Rate]) * 100
		formatString: 0.00
		displayFolder: Target
		lineageTag: ea5a74ea-af91-4b98-80dd-180d6338f1a7

	measure 'Wilson Lower 95' = VAR n=[Total Leads] VAR p=[Close Rate] VAR z=1.96 VAR d=1+DIVIDE(z*z,n) VAR c=DIVIDE(p+DIVIDE(z*z,2*n),d) VAR m=DIVIDE(z*SQRT(DIVIDE(p*(1-p),n)+DIVIDE(z*z,4*n*n)),d) RETURN IF(n>0,MAX(0,c-m))
		formatString: 0.00%
		displayFolder: Uncertainty
		lineageTag: b6088b60-c0c3-4daa-95ef-bedbf2615979

	measure 'Wilson Upper 95' = VAR n=[Total Leads] VAR p=[Close Rate] VAR z=1.96 VAR d=1+DIVIDE(z*z,n) VAR c=DIVIDE(p+DIVIDE(z*z,2*n),d) VAR m=DIVIDE(z*SQRT(DIVIDE(p*(1-p),n)+DIVIDE(z*z,4*n*n)),d) RETURN IF(n>0,MIN(1,c+m))
		formatString: 0.00%
		displayFolder: Uncertainty
		lineageTag: 7339917f-ee63-4d7c-b200-aeaf0fa43ccc

	measure 'Scenario Leads Affected' = SELECTEDVALUE(TargetScenarios[LeadsAffected], MAX(TargetScenarios[LeadsAffected]))
		formatString: #,0
		displayFolder: Scenario
		lineageTag: 746a8159-4df1-456c-b85a-9f88703b3c52

	measure 'Scenario Destination Rate' = SELECTEDVALUE(TargetScenarios[AssumedDestinationRate], MAX(TargetScenarios[AssumedDestinationRate]))
		formatString: 0.00%
		displayFolder: Scenario
		lineageTag: 49783be2-ab09-4957-b034-08eb5d5336a1

	measure 'Scenario Incremental Closes' = SELECTEDVALUE(TargetScenarios[ExpectedIncrementalCloses], MAX(TargetScenarios[ExpectedIncrementalCloses]))
		formatString: #,0.0
		displayFolder: Scenario
		lineageTag: 8fdcd36c-4203-4a57-9edb-32813e7f33d7

	measure 'Scenario Total Closes' = [Closed Leads] + [Scenario Incremental Closes]
		formatString: #,0.0
		displayFolder: Scenario
		lineageTag: a7f16cf9-2cef-4b57-ac1d-ee8ab4680c8b

	measure 'Scenario Close Rate' = DIVIDE([Scenario Total Closes], [Total Leads])
		formatString: 0.00%
		displayFolder: Scenario
		lineageTag: 9eab3cea-d94a-4917-8ad8-472380a9c525

	measure 'Scenario Remaining Gap' = MAX(0, [Target Closes] - [Scenario Total Closes])
		formatString: #,0.0
		displayFolder: Scenario
		lineageTag: 81316983-101b-4f4f-9627-97c38bed7113

	measure 'Scenario Meets Target' = IF([Scenario Close Rate] >= [Target Close Rate], 1, 0)
		formatString: 0
		displayFolder: Scenario
		lineageTag: 29f9f6d0-54a2-4ea4-91df-3b45ab479646

	measure 'Scenario Revenue' = SELECTEDVALUE(TargetScenarios[CommercialRevenueAtStatedOffer], MAX(TargetScenarios[CommercialRevenueAtStatedOffer]))
		formatString: $#,0
		displayFolder: Scenario
		lineageTag: 33544733-dbdf-4d4c-980e-42e343cb8b82

